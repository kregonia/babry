// 截图编辑界面：负责选区交互、工具栏和文字输入，图像检测与标注渲染通过回调交给 Rust。
import { EditorToolbar, ToolMenuItem } from "toolbar.slint";
import { ColorPalette } from "color-palette.slint";

// 导出给 Rust 控制器的主窗口，统一管理选区阶段与标注阶段。
export component AppWindow inherits Window {
    title: "Babry";
    background: black;
    // 默认将键盘焦点交给快捷键区域；文字输入框创建后会主动获取焦点。
    forward-focus: keyboard;

    // 原图仅上传一次；编辑画布和当前预览按需创建，尺寸分别为选区和局部标注区域。
    in property <image> screenshot;
    in property <image> committed-image;
    in property <image> preview-image;
    in property <bool> has-committed: false;
    in property <bool> has-preview: false;
    in property <float> canvas-x;
    in property <float> canvas-y;
    in property <float> canvas-width;
    in property <float> canvas-height;
    in property <float> preview-x;
    in property <float> preview-y;
    in property <float> preview-width;
    in property <float> preview-height;

    // 阶段编号与 Rust 控制器约定一致；全屏截图模式可直接进入阶段 2。
    in-out property <int> phase: 0; // 0：智能或手动选区；2：标注编辑。
    in property <bool> selection-loading: false; // 后台分析时允许手动拖框。
    property <bool> selection-pointer-known: false; // 结果到达时用最近一次悬停位置刷新。
    // 工具是唯一模式状态：0 表示未选择工具，此时拖动选区；再次点击工具按钮即可回到 0。
    // 1 画笔、2 矩形、7 荧光笔、8 效果、10 文字、11 数字、12 橡皮擦、13 方形、14 圆形。
    in-out property <int> tool: 0;
    out property <bool> editing-mode: root.tool != 0;
    in-out property <int> shape-tool: 2;
    in property <int> next-number: 1;
    in-out property <color> active-color: #ff3b30; // 当前标注颜色。
    in-out property <int> line-width: 4; // 线条或笔刷粗细。
    in-out property <float> text-font-size: 24; // 文字字号，单位为界面逻辑像素。
    in-out property <string> text-font-family: ""; // 与导出渲染一致的字体族名称。
    in-out property <int> effect-mode: 0; // 0：马赛克；1：模糊。
    in-out property <float> blur-strength-value: 8; // 模糊强度，调用渲染回调时取整。
    // 工具栏拖动与截图选区完全独立；手动放置后保持位置，窗口缩放时仍钳制边界。
    property <bool> toolbar-positioned: false;
    property <bool> toolbar-dragging: false;
    property <length> toolbar-drag-offset-x;
    property <length> toolbar-drag-offset-y;
    property <length> toolbar-manual-x;
    property <length> toolbar-manual-y;
    out property <length> toolbar-width: min(600px, max(1px, root.width - 16px));
    out property <length> toolbar-height: root.tool == 0 ? 50px : root.tool == 8 && root.effect-mode == 1 ? 136px : 98px;
    out property <length> toolbar-x: clamp(root.toolbar-positioned ? root.toolbar-manual-x : root.sx * root.width, 0px, max(0px, root.width - root.toolbar-width));
    out property <length> toolbar-y: clamp(root.toolbar-positioned ? root.toolbar-manual-y : (root.sy + root.sh) * root.height + 12px, 0px, max(0px, root.height - root.toolbar-height - 8px));
    in-out property <int> open-menu: 0; // 1 形状、2 效果、3 颜色；浮层不受工具栏横向滚动裁剪。
    property <length> menu-anchor-x;
    property <length> menu-anchor-y;
    property <length> menu-height: root.open-menu == 3 ? 174px : root.open-menu == 1 ? 122px : 86px;
    property <length> menu-width: root.open-menu == 3 ? 278px : 160px;
    out property <length> menu-x: clamp(root.menu-anchor-x - 34px, 8px, max(8px, root.width - root.menu-width - 8px));
    out property <length> menu-y: clamp(root.menu-anchor-y >= root.menu-height + 8px ? root.menu-anchor-y - root.menu-height - 8px : root.menu-anchor-y + 42px, 8px, max(8px, root.height - root.menu-height - 8px));

    // 文字输入在确认前只更新预览，取消时丢弃待提交内容。
    property <bool> text-editing: false; // 是否显示文字输入框。
    in-out property <float> text-x: 0; // 文字落点的归一化横坐标。
    in-out property <float> text-y: 0; // 文字落点的归一化纵坐标。
    in-out property <string> text-value: ""; // 正在输入的文字内容。

    // 所有画布坐标均相对整个截图归一化到 0～1，乘窗口宽高后用于界面布局。
    property <bool> drawing: false; // 是否正在绘制尚未提交的标注。
    property <bool> selecting: false; // 是否已从智能候选切换为手动拖框。
    property <float> ax: 0; // 本次按下位置的横坐标，作为拖动起点。
    property <float> ay: 0; // 本次按下位置的纵坐标。
    property <float> dx: 0; // 最近一次移动位置的横坐标。
    property <float> dy: 0; // 最近一次移动位置的纵坐标。
    in-out property <float> sx: 0; // 选区左上角的横坐标，由 CV 回调或手动拖框更新。
    in-out property <float> sy: 0; // 选区左上角的纵坐标。
    in-out property <float> sw: 0; // 选区宽度占截图宽度的比例。
    in-out property <float> sh: 0; // 选区高度占截图高度的比例。
    // 选区调整期间保存按下时的矩形；边缘操作在移动和编辑模式都可用。
    property <bool> selection-manipulating: false;
    property <int> selection-manipulation-kind: 0; // 1：整体移动，2：边缘或角点缩放。
    property <int> selection-edge: 0; // 1 左、2 上、3 右、4 下、5 左上、6 右上、7 右下、8 左下。
    property <float> selection-base-x: 0;
    property <float> selection-base-y: 0;
    property <float> selection-base-width: 0;
    property <float> selection-base-height: 0;
    property <length> selection-handle-size: 14px;
    property <float> minimum-selection-width: 0.005;
    property <float> minimum-selection-height: 0.005;
    // 过滤接近零尺寸的区域，只有宽高均超过阈值时才能确认选区。
    property <bool> has-selection: root.sw > 0.001 && root.sh > 0.001;

    // 将鼠标的归一化坐标传给 Rust 的 CV 检测器，命中结果写回 sx、sy、sw、sh。
    callback editing-started(); // 选区确认后释放检测状态，编辑画布继续延迟创建。
    callback selection-changed(float, float, float, float); // 移动或缩放完成后更新导出选区。
    callback hover-selection(float, float);
    callback cycle-selection(float, float, int); // 滚轮向上扩大到父区域，向下缩小到子区域。
    callback refresh-selection();
    refresh-selection => {
        if (root.phase == 0 && root.selection-pointer-known && !touch.pressed && !root.selecting) {
            root.hover-selection(root.dx, root.dy);
        }
    }
    // 参数依次为工具编号、起点横坐标、起点纵坐标、颜色、粗细、效果模式、模糊强度。
    callback begin-mark(int, float, float, color, int, int, int);
    callback update-mark(float, float); // 用归一化坐标更新端点或笔刷轨迹。
    callback commit-mark(); // 结束当前标注，由 Rust 更新历史与已提交画布。
    callback cancel-mark(); // 丢弃待提交标注，恢复已提交画布。
    // 文字回调参数依次为归一化横坐标、归一化纵坐标、颜色、字号。
    // 最后一个参数是从文字落点到选区右边缘的可用宽度比例。
    callback begin-text(float, float, color, int, float);
    callback update-text(string); // 输入变化时同步待提交文字。
    callback update-text-style(color, int, float); // 颜色或字号变化时同步 Rust 标注样式。
    callback commit-text(string); // 确认文字，由 Rust 将有效内容写入历史。
    callback cancel-text(); // 取消文字预览。
    callback undo(); // 撤销最近一次已提交标注。
    callback redo(); // 重做已撤销的标注。
    callback save(); // 导出选区并保存图片。
    callback copy(); // 导出选区并复制到剪贴板。
    callback pin(); // 导出选区并创建屏幕贴图。
    callback cancel(); // 关闭截图编辑窗口。
    callback session-finished(); // 工作流统一收尾：前台退出，后台释放截图后继续等待。

    public function focus-editor() { keyboard.focus(); }

    public function reset-session() {
        root.phase = 0;
        root.tool = 0;
        root.open-menu = 0;
        root.text-editing = false;
        root.text-value = "";
        root.text-x = 0;
        root.text-y = 0;
        root.drawing = false;
        root.selecting = false;
        root.selection-manipulating = false;
        root.selection-edge = 0;
        root.selection-pointer-known = false;
        root.sx = 0;
        root.sy = 0;
        root.sw = 0;
        root.sh = 0;
        root.toolbar-positioned = false;
        root.toolbar-dragging = false;
        keyboard.focus();
    }

    // 提交当前文字但不关闭编辑器，供点击工具栏、保存或点击画布外部时复用。
    function finish-text-input() {
        if (root.text-editing) {
            root.commit-text(root.text-value);
            root.text-editing = false;
            root.text-value = "";
        }
    }

    // 主按钮再次点击取消选中；菜单选择子工具时直接启用，切换高斯模糊不会误取消。
    public function select-tool(value: int) {
        root.finish-text-input();
        root.open-menu = 0;
        root.tool = root.tool == value ? 0 : value;
        keyboard.focus();
    }

    function select-shape(value: int) {
        root.finish-text-input();
        root.shape-tool = value;
        root.tool = value;
        root.open-menu = 0;
        keyboard.focus();
    }

    function select-effect(value: int) {
        root.finish-text-input();
        root.effect-mode = value;
        root.tool = 8;
        root.open-menu = 0;
        keyboard.focus();
    }

    function has-left-edge(edge: int) -> bool {
        return edge == 1 || edge == 5 || edge == 8;
    }
    function has-top-edge(edge: int) -> bool {
        return edge == 2 || edge == 5 || edge == 6;
    }
    function has-right-edge(edge: int) -> bool {
        return edge == 3 || edge == 6 || edge == 7;
    }
    function has-bottom-edge(edge: int) -> bool {
        return edge == 4 || edge == 7 || edge == 8;
    }

    // 统一命中角点和边线，命中区域略大于可见控制点，方便高分屏操作。
    function selection-edge-at(x: length, y: length) -> int {
        let left = root.sx * root.width;
        let top = root.sy * root.height;
        let right = (root.sx + root.sw) * root.width;
        let bottom = (root.sy + root.sh) * root.height;
        let tolerance = root.selection-handle-size;
        if (!root.has-selection) { return 0; }
        if (abs(x - left) <= tolerance && abs(y - top) <= tolerance) { return 5; }
        if (abs(x - right) <= tolerance && abs(y - top) <= tolerance) { return 6; }
        if (abs(x - right) <= tolerance && abs(y - bottom) <= tolerance) { return 7; }
        if (abs(x - left) <= tolerance && abs(y - bottom) <= tolerance) { return 8; }
        if (abs(x - left) <= tolerance && y >= top && y <= bottom) { return 1; }
        if (abs(y - top) <= tolerance && x >= left && x <= right) { return 2; }
        if (abs(x - right) <= tolerance && y >= top && y <= bottom) { return 3; }
        if (abs(y - bottom) <= tolerance && x >= left && x <= right) { return 4; }
        return 0;
    }

    function cursor-for-position(x: length, y: length) -> MouseCursor {
        let edge = root.selection-edge-at(x, y);
        if (edge == 1 || edge == 3) { return ew-resize; }
        if (edge == 2 || edge == 4) { return ns-resize; }
        if (edge == 5 || edge == 7) { return nwse-resize; }
        if (edge == 6 || edge == 8) { return nesw-resize; }
        let inside = root.has-selection
            && x >= root.sx * root.width
            && x <= (root.sx + root.sw) * root.width
            && y >= root.sy * root.height
            && y <= (root.sy + root.sh) * root.height;
        if (root.phase == 0) { return crosshair; }
        if (inside && (!root.editing-mode || root.tool == 0)) { return move; }
        if (inside && root.editing-mode && root.tool != 0) { return crosshair; }
        return default;
    }

    function begin-selection-move(x: float, y: float) {
        root.selection-manipulating = true;
        root.selection-manipulation-kind = 1;
        root.selection-edge = 0;
        root.ax = x;
        root.ay = y;
        root.selection-base-x = root.sx;
        root.selection-base-y = root.sy;
        root.selection-base-width = root.sw;
        root.selection-base-height = root.sh;
    }

    function begin-selection-resize(edge: int, x: float, y: float) {
        root.selection-manipulating = true;
        root.selection-manipulation-kind = 2;
        root.selection-edge = edge;
        root.ax = x;
        root.ay = y;
        root.selection-base-x = root.sx;
        root.selection-base-y = root.sy;
        root.selection-base-width = root.sw;
        root.selection-base-height = root.sh;
    }

    function update-selection-manipulation(x: float, y: float) {
        if (!root.selection-manipulating) { return; }
        let dx = x - root.ax;
        let dy = y - root.ay;
        if (root.selection-manipulation-kind == 1) {
            root.sx = clamp(root.selection-base-x + dx, 0, 1 - root.selection-base-width);
            root.sy = clamp(root.selection-base-y + dy, 0, 1 - root.selection-base-height);
            return;
        }
        if (root.has-left-edge(root.selection-edge)) {
            root.sx = clamp(root.selection-base-x + dx, 0, root.selection-base-x + root.selection-base-width - root.minimum-selection-width);
            root.sw = root.selection-base-x + root.selection-base-width - root.sx;
        } else if (root.has-right-edge(root.selection-edge)) {
            root.sx = root.selection-base-x;
            root.sw = clamp(root.selection-base-width + dx, root.minimum-selection-width, 1 - root.sx);
        }
        if (root.has-top-edge(root.selection-edge)) {
            root.sy = clamp(root.selection-base-y + dy, 0, root.selection-base-y + root.selection-base-height - root.minimum-selection-height);
            root.sh = root.selection-base-y + root.selection-base-height - root.sy;
        } else if (root.has-bottom-edge(root.selection-edge)) {
            root.sy = root.selection-base-y;
            root.sh = clamp(root.selection-base-height + dy, root.minimum-selection-height, 1 - root.sy);
        }
    }

    function finish-selection-manipulation() {
        if (!root.selection-manipulating) { return; }
        root.selection-manipulating = false;
        let changed = abs(root.sx - root.selection-base-x) > 0.00001
            || abs(root.sy - root.selection-base-y) > 0.00001
            || abs(root.sw - root.selection-base-width) > 0.00001
            || abs(root.sh - root.selection-base-height) > 0.00001;
        if (root.phase == 2 && changed) {
            root.selection-changed(root.sx, root.sy, root.sw, root.sh);
        } else if (root.phase == 0 && changed) {
            // 选区阶段调整边界后锁定当前矩形，下一次单击直接确认，不被 CV 候选抢回去。
            root.selecting = true;
        } else if (root.phase == 0) {
            // 点击边线但没有移动仍视为确认，避免边界上的普通单击失去确认语义。
            root.selecting = false;
            if (root.has-selection) {
                root.phase = 2;
                root.editing-started();
            }
        }
        root.selection-edge = 0;
    }

    // 全局快捷键区域；文字输入框另行处理输入过程中的按键。
    keyboard := FocusScope {
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                // 取消顺序：文字输入、当前绘制、整个截图窗口。
                if (root.open-menu != 0) {
                    root.open-menu = 0;
                } else if (root.text-editing) {
                    root.cancel-text();
                    root.text-editing = false;
                    root.text-value = "";
                } else if (root.drawing) {
                    root.cancel-mark();
                    root.drawing = false;
                } else if (root.tool != 0) {
                    root.select-tool(root.tool);
                } else {
                    root.cancel();
                }
            }
        }
        // 仅在编辑阶段且未输入文字时启用，避免与输入框的编辑操作冲突。
        KeyBinding { keys: @keys(Control + Z); enabled: root.phase == 2 && !root.text-editing; activated => { root.undo(); } }
        KeyBinding { keys: @keys(Control + Shift + Z); enabled: root.phase == 2 && !root.text-editing; activated => { root.redo(); } }
        KeyBinding { keys: @keys(Control + Y); enabled: root.phase == 2 && !root.text-editing; activated => { root.redo(); } }
        KeyBinding { keys: @keys(Control + S); enabled: root.phase == 2 && !root.text-editing; activated => { root.save(); } }
        KeyBinding { keys: @keys(Control + C); enabled: root.phase == 2 && !root.text-editing; activated => { root.copy(); } }
    }

    // 图层从下到上依次为背景、已提交画布、预览、遮罩、选区边框和操作面板。
    // 原始截图始终作为底图，选择阶段直接展示这张图像。
    Image {
        source <=> root.screenshot;
        width: 100%;
        height: 100%;
        image-fit: fill;
        z: 0;
    }
    // 进入编辑阶段后显示已提交标注，撤销与重做会更新此图层。
    Rectangle {
        x: root.sx * root.width;
        y: root.sy * root.height;
        width: root.sw * root.width;
        height: root.sh * root.height;
        clip: true;
        z: 1;
        // 移动选区只改变裁剪范围，已有截图内容和标注不会被拉伸或跟随选框平移。
        Image {
            source <=> root.committed-image;
            x: (root.canvas-x - root.sx) * root.width;
            y: (root.canvas-y - root.sy) * root.height;
            width: root.canvas-width * root.width;
            height: root.canvas-height * root.height;
            image-fit: fill;
            visible: root.phase == 2 && root.has-committed;
        }
    }
    // 只有绘制或文字输入期间显示预览，确认后由已提交画布接替。
    Image {
        source <=> root.preview-image;
        x: root.preview-x * root.width;
        y: root.preview-y * root.height;
        width: root.preview-width * root.width;
        height: root.preview-height * root.height;
        image-fit: fill;
        // 文字输入由透明 TextInput 绘制，避免待提交位图文字与输入文字重叠。
        visible: root.phase == 2 && root.has-preview && root.drawing && !root.text-editing;
        z: 2;
    }

    // 四块半透明遮罩覆盖选区外侧，随智能吸附或手动拖框更新，进入编辑后继续保留。
    // 上侧遮罩覆盖窗口全宽，下侧与左右遮罩共同留出透明的选区中心。
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: root.sy * root.height;
        background: #00000099;
        visible: (root.has-selection || root.selecting) && (root.phase == 0 || root.phase == 2);
        z: 3;
    }
    // 下侧遮罩从选区底边延伸到窗口底部。
    Rectangle {
        x: 0;
        y: (root.sy + root.sh) * root.height;
        width: 100%;
        height: root.height - self.y;
        background: #00000099;
        visible: (root.has-selection || root.selecting) && (root.phase == 0 || root.phase == 2);
        z: 3;
    }
    // 左侧遮罩只覆盖选区所在的高度，避免与上下遮罩叠加变暗。
    Rectangle {
        x: 0;
        y: root.sy * root.height;
        width: root.sx * root.width;
        height: root.sh * root.height;
        background: #00000099;
        visible: (root.has-selection || root.selecting) && (root.phase == 0 || root.phase == 2);
        z: 3;
    }
    // 右侧遮罩与左侧对称，从选区右边缘延伸到窗口右侧。
    Rectangle {
        x: (root.sx + root.sw) * root.width;
        y: root.sy * root.height;
        width: root.width - self.x;
        height: root.sh * root.height;
        background: #00000099;
        visible: (root.has-selection || root.selecting) && (root.phase == 0 || root.phase == 2);
        z: 3;
    }

    // 蓝色边框标出当前候选或已确认选区，短动画平滑显示位置与尺寸变化。
    Rectangle {
        x: root.sx * root.width;
        y: root.sy * root.height;
        width: root.sw * root.width;
        height: root.sh * root.height;
        border-width: 2px;
        border-color: #55aaff;
        background: transparent;
        visible: root.has-selection || root.selecting;
        z: 4;
        animate x, y, width, height { duration: 45ms; easing: ease-out; }
    }
    // 八个白色控制点对应四角和四条边；实际命中区域由上面的 TouchArea 统一扩大。
    for handle in [0, 1, 2, 3]: Rectangle {
        x: (handle == 1 || handle == 3 ? (root.sx + root.sw) * root.width : root.sx * root.width) - 4px;
        y: (handle >= 2 ? (root.sy + root.sh) * root.height : root.sy * root.height) - 4px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: #ffffff;
        visible: root.has-selection;
        z: 5;
    }
    Rectangle {
        x: (root.sx + root.sw / 2) * root.width - 5px;
        y: root.sy * root.height - 4px;
        width: 10px;
        height: 8px;
        border-radius: 4px;
        background: #ffffff;
        visible: root.has-selection;
        z: 5;
    }
    Rectangle {
        x: (root.sx + root.sw) * root.width - 4px;
        y: (root.sy + root.sh / 2) * root.height - 5px;
        width: 8px;
        height: 10px;
        border-radius: 4px;
        background: #ffffff;
        visible: root.has-selection;
        z: 5;
    }
    Rectangle {
        x: (root.sx + root.sw / 2) * root.width - 5px;
        y: (root.sy + root.sh) * root.height - 4px;
        width: 10px;
        height: 8px;
        border-radius: 4px;
        background: #ffffff;
        visible: root.has-selection;
        z: 5;
    }
    Rectangle {
        x: root.sx * root.width - 4px;
        y: (root.sy + root.sh / 2) * root.height - 5px;
        width: 8px;
        height: 10px;
        border-radius: 4px;
        background: #ffffff;
        visible: root.has-selection;
        z: 5;
    }
    // 选择阶段在选区上方显示尺寸，提示位置距窗口左边和顶部至少 8px。
    // 尺寸根据窗口宽高计算，单位为 Slint 逻辑像素。
    if root.phase == 0 && root.has-selection: Rectangle {
        x: max(root.sx * root.width, 8px);
        y: max(root.sy * root.height - 30px, 8px);
        width: 116px;
        height: 24px;
        border-radius: 4px;
        background: #20242bdd;
        z: 6;
        Text {
            text: round(root.sw * root.width / 1px) + " × " + round(root.sh * root.height / 1px);
            color: #ffffff;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.phase == 0 && root.selection-loading: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 24px;
        width: 270px;
        height: 36px;
        border-radius: 6px;
        background: #20242bdd;
        z: 6;
        Text {
            text: "正在寻找选区，可直接拖动框选";
            color: #ffffff;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // 全窗口输入区域统一处理选区、移动、缩放与绘制；工具栏和文字面板使用更高图层接收自身操作。
    touch := TouchArea {
        z: 10;
        // 直接让 Slint 根据命中边线切换系统缩放光标；边线命中优先于内部移动光标。
        mouse-cursor: root.cursor-for-position(self.mouse-x, self.mouse-y);
        // moved 仅在鼠标按住或手指保持接触时触发，悬停移动由 pointer-event 处理。
        moved => {
            if (root.phase == 0 && root.selection-manipulating) {
                root.dx = clamp(self.mouse-x / root.width, 0, 1);
                root.dy = clamp(self.mouse-y / root.height, 0, 1);
                root.update-selection-manipulation(root.dx, root.dy);
            } else if (root.phase == 0) {
                root.dx = clamp(self.mouse-x / root.width, 0, 1);
                root.dy = clamp(self.mouse-y / root.height, 0, 1);
                // 任一方向移动至少 3px 时使用手动框选，微小抖动仍保留智能候选。
                if (abs(self.mouse-x - self.pressed-x) >= 3px || abs(self.mouse-y - self.pressed-y) >= 3px) {
                    root.selecting = true;
                    // 取较小坐标与绝对距离，支持从任意角向相反方向拖框。
                    root.sx = min(root.ax, root.dx);
                    root.sy = min(root.ay, root.dy);
                    root.sw = abs(root.dx - root.ax);
                    root.sh = abs(root.dy - root.ay);
                }
            }
            if (root.phase == 2 && root.selection-manipulating) {
                root.dx = clamp(self.mouse-x / root.width, 0, 1);
                root.dy = clamp(self.mouse-y / root.height, 0, 1);
                root.update-selection-manipulation(root.dx, root.dy);
            }
            // 绘制时将轨迹钳制在已确认选区内，文字输入期间暂停画布绘制。
            if (self.pressed && root.phase == 2 && root.drawing && root.editing-mode && root.tool != 0 && !root.text-editing) {
                root.dx = clamp(self.mouse-x / root.width, root.sx, root.sx + root.sw);
                root.dy = clamp(self.mouse-y / root.height, root.sy, root.sy + root.sh);
                root.update-mark(root.dx, root.dy);
            }
        }
        scroll-event(event) => {
            if (root.phase == 0 && !self.pressed && event.delta-y != 0px) {
                root.cycle-selection(
                    clamp(self.mouse-x / root.width, 0, 1),
                    clamp(self.mouse-y / root.height, 0, 1),
                    event.delta-y > 0px ? 1 : -1,
                );
                return accept;
            }
            return reject;
        }
        pointer-event(event) => {
            // 未按下鼠标时持续更新 CV 候选；按下后冻结候选，等待单击确认或手动拖框。
            if (event.kind == PointerEventKind.move && root.phase == 0 && !self.pressed && !root.selecting) {
                root.dx = clamp(self.mouse-x / root.width, 0, 1);
                root.dy = clamp(self.mouse-y / root.height, 0, 1);
                root.selection-pointer-known = true;
                root.hover-selection(root.dx, root.dy);
            }
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left && root.phase == 2 && root.text-editing) {
                // 文字输入框和工具栏位于更高图层；能到达画布的按下事件表示点击了外部。
                root.finish-text-input();
            } else if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                // 记录归一化起点，供手动选区、移动、缩放、形状绘制和文字定位共同使用。
                root.ax = clamp(self.mouse-x / root.width, 0, 1);
                root.ay = clamp(self.mouse-y / root.height, 0, 1);
                root.dx = root.ax;
                root.dy = root.ay;
                if (root.phase == 0) {
                    let edge = root.selection-edge-at(self.mouse-x, self.mouse-y);
                    if (edge != 0) {
                        // 候选已显示时，边线和角点优先进入调整，而不是重新创建手动框。
                        root.begin-selection-resize(edge, root.ax, root.ay);
                    } else {
                        // 普通候选按下时刷新一次；手动调整后的矩形保持不变，单击直接确认。
                        if (!root.selecting) {
                            root.hover-selection(root.ax, root.ay);
                        }
                    }
                } else if (root.phase == 2 && !root.text-editing && root.has-selection) {
                    let edge = root.selection-edge-at(self.mouse-x, self.mouse-y);
                    if (edge != 0) {
                        // 角点和边线在移动模式、编辑模式都始终可以调整选区。
                        root.begin-selection-resize(edge, root.ax, root.ay);
                    } else if (root.ax >= root.sx && root.ax <= root.sx + root.sw && root.ay >= root.sy && root.ay <= root.sy + root.sh && (!root.editing-mode || root.tool == 0)) {
                        // 默认移动模式：拖动选区内部整体平移。
                        root.begin-selection-move(root.ax, root.ay);
                    } else if (root.editing-mode && root.tool != 0 && root.ax >= root.sx && root.ax <= root.sx + root.sw && root.ay >= root.sy && root.ay <= root.sy + root.sh) {
                        // 仅编辑模式允许开始标注；文字工具立即创建透明原位输入框。
                        if (root.tool == 10) {
                            root.text-x = clamp(root.ax, root.sx, root.sx + root.sw);
                            root.text-y = clamp(root.ay, root.sy, root.sy + root.sh);
                            root.text-value = "";
                            root.text-editing = true;
                            root.begin-text(
                                root.text-x,
                                root.text-y,
                                root.active-color,
                                round(root.text-font-size),
                                max(0.001, root.sx + root.sw - root.text-x),
                            );
                        } else {
                            root.drawing = true;
                            root.begin-mark(root.tool, root.ax, root.ay, root.active-color, root.line-width, root.effect-mode, round(root.blur-strength-value));
                        }
                    }
                }
            }
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                if (root.phase == 0 && root.selection-manipulating) {
                    root.update-selection-manipulation(clamp(self.mouse-x / root.width, 0, 1), clamp(self.mouse-y / root.height, 0, 1));
                    root.finish-selection-manipulation();
                } else if (root.phase == 0) {
                    // 智能单击与手动拖框共用确认流程，有效选区进入编辑阶段。
                    root.selecting = false;
                    if (root.has-selection) {
                        root.phase = 2;
                        root.editing-started();
                    }
                } else if (root.phase == 2 && root.selection-manipulating) {
                    root.update-selection-manipulation(clamp(self.mouse-x / root.width, 0, 1), clamp(self.mouse-y / root.height, 0, 1));
                    root.finish-selection-manipulation();
                } else if (root.phase == 2 && root.drawing && root.editing-mode && !root.text-editing) {
                    // 松开时仍取实际鼠标位置，避免最后一次移动未刷新导致笔迹提前结束。
                    root.dx = clamp(self.mouse-x / root.width, root.sx, root.sx + root.sw);
                    root.dy = clamp(self.mouse-y / root.height, root.sy, root.sy + root.sh);
                    root.update-mark(root.dx, root.dy);
                    root.commit-mark();
                    root.drawing = false;
                }
            }
            if (event.kind == PointerEventKind.cancel) {
                if (root.drawing) { root.cancel-mark(); root.drawing = false; }
                if (root.selection-manipulating) {
                    root.sx = root.selection-base-x;
                    root.sy = root.selection-base-y;
                    root.sw = root.selection-base-width;
                    root.sh = root.selection-base-height;
                    root.selection-manipulating = false;
                    root.selection-edge = 0;
                }
            }
        }
    }

    // 文字输入直接覆盖在画布上：浅透明背景与细边框标出输入范围，字号和颜色与最终标注一致。
    // 宽度限制在当前选区内，输入内容自动换行并随字号增高；Ctrl+Enter 或点击外部提交。
    if root.phase == 2 && root.text-editing: text-editor := Rectangle {
        property <length> available-width: max(40px, (root.sx + root.sw - root.text-x) * root.width);
        property <length> available-height: max(32px, (root.sy + root.sh - root.text-y) * root.height);
        x: root.text-x * root.width;
        y: root.text-y * root.height;
        // 输入框随文字首行宽度增长，达到选区右边缘后改为逐字换行。
        width: min(available-width, max(40px, text-input.preferred-width + 8px));
        height: min(available-height, max(32px, text-input.preferred-height + 8px));
        background: #00000018;
        border-width: 1px;
        border-color: #72b7ff88;
        border-radius: 2px;
        clip: true;
        z: 30;

        text-input := TextInput {
            text <=> root.text-value;
            x: 4px;
            y: 3px;
            width: max(1px, parent.width - 8px);
            height: max(1px, parent.height - 6px);
            font-size: root.text-font-size * 1px;
            font-family: root.text-font-family;
            color: root.active-color;
            font-weight: 400;
            wrap: char-wrap;
            single-line: false;
            vertical-alignment: top;
            text-cursor-width: 2px;
            selection-background-color: #72b7ff66;
            selection-foreground-color: #ffffff;
            edited => { root.update-text(self.text); }
            key-pressed(event) => {
                if (event.text == Key.Escape && root.open-menu != 0) {
                    root.open-menu = 0;
                    return accept;
                }
                if (event.text == Key.Escape) {
                    root.cancel-text();
                    root.text-editing = false;
                    root.text-value = "";
                    return accept;
                }
                if (event.text == Key.Return && event.modifiers.control) {
                    root.commit-text(root.text-value);
                    root.text-editing = false;
                    root.text-value = "";
                    return accept;
                }
                return reject;
            }
            init => { self.focus(); }
        }
    }

    // 原位输入框可能覆盖选区边缘；四条边的独立命中条位于文字框上方，仍可直接缩放。
    for edge in [1, 2, 3, 4]: TouchArea {
        x: edge == 1 ? root.sx * root.width - 7px : edge == 3 ? (root.sx + root.sw) * root.width - 7px : root.sx * root.width - 7px;
        y: edge == 2 ? root.sy * root.height - 7px : edge == 4 ? (root.sy + root.sh) * root.height - 7px : root.sy * root.height - 7px;
        width: edge == 1 || edge == 3 ? 14px : root.sw * root.width + 14px;
        height: edge == 2 || edge == 4 ? 14px : root.sh * root.height + 14px;
        enabled: root.phase == 2 && root.has-selection;
        z: 35;
        mouse-cursor: root.cursor-for-position(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                let x = self.absolute-position.x + self.mouse-x;
                let y = self.absolute-position.y + self.mouse-y;
                root.finish-text-input();
                root.begin-selection-resize(root.selection-edge-at(x, y), x / root.width, y / root.height);
            }
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                root.update-selection-manipulation(clamp((self.absolute-position.x + self.mouse-x) / root.width, 0, 1), clamp((self.absolute-position.y + self.mouse-y) / root.height, 0, 1));
                root.finish-selection-manipulation();
            }
            if (event.kind == PointerEventKind.cancel && root.selection-manipulating) {
                root.sx = root.selection-base-x;
                root.sy = root.selection-base-y;
                root.sw = root.selection-base-width;
                root.sh = root.selection-base-height;
                root.selection-manipulating = false;
            }
        }
        moved => {
            root.update-selection-manipulation(clamp((self.absolute-position.x + self.mouse-x) / root.width, 0, 1), clamp((self.absolute-position.y + self.mouse-y) / root.height, 0, 1));
        }
    }

    // 工具栏始终显示同一组工具；未选中工具时只收起参数行。
    if root.phase == 2: toolbar := EditorToolbar {
        x: root.toolbar-x;
        y: root.toolbar-y;
        width: root.toolbar-width;
        tool: root.tool;
        shape-tool: root.shape-tool;
        effect-mode: root.effect-mode;
        active-color <=> root.active-color;
        line-width <=> root.line-width;
        text-font-size <=> root.text-font-size;
        effect-strength: round(root.blur-strength-value);
        next-number: root.next-number;
        z: 40;
        activate(value) => { root.select-tool(value); }
        menu-request(kind, x, y) => {
            root.menu-anchor-x = x;
            root.menu-anchor-y = y;
            root.open-menu = root.open-menu == kind ? 0 : kind;
        }
        color-changed => { root.update-text-style(root.active-color, round(root.text-font-size), max(0.001, root.sx + root.sw - root.text-x)); }
        text-style-changed => { root.update-text-style(root.active-color, round(root.text-font-size), max(0.001, root.sx + root.sw - root.text-x)); }
        changed effect-strength => { root.blur-strength-value = self.effect-strength; }
        undo => { root.finish-text-input(); root.undo(); keyboard.focus(); }
        redo => { root.finish-text-input(); root.redo(); keyboard.focus(); }
        save => { root.finish-text-input(); root.save(); }
        copy => { root.finish-text-input(); root.copy(); }
        pin => { root.finish-text-input(); root.pin(); }
        cancel => { root.cancel(); }
        drag-start(x, y) => {
            root.finish-text-input();
            root.open-menu = 0;
            root.toolbar-manual-x = root.toolbar-x;
            root.toolbar-manual-y = root.toolbar-y;
            root.toolbar-drag-offset-x = x - root.toolbar-x;
            root.toolbar-drag-offset-y = y - root.toolbar-y;
            root.toolbar-positioned = true;
            root.toolbar-dragging = true;
        }
        drag-update(x, y) => {
            if (root.toolbar-dragging) {
                root.toolbar-manual-x = clamp(x - root.toolbar-drag-offset-x, 0px, max(0px, root.width - root.toolbar-width));
                root.toolbar-manual-y = clamp(y - root.toolbar-drag-offset-y, 0px, max(0px, root.height - root.toolbar-height - 8px));
            }
        }
        drag-finish => { root.toolbar-dragging = false; }
    }

    // 独立窗口浮层，四个 TODO 功能和折线不显示在工具栏上。
    if root.phase == 2 && root.open-menu != 0: Rectangle {
        z: 50;
        TouchArea {
            clicked => { root.open-menu = 0; }
            mouse-cursor: default;
        }
        if root.open-menu == 3: ColorPalette {
            x: root.menu-x;
            y: root.menu-y;
            selected-color: root.active-color;
            color-selected(color) => {
                root.active-color = color;
                root.update-text-style(color, round(root.text-font-size), max(0.001, root.sx + root.sw - root.text-x));
                root.open-menu = 0;
            }
        }
        if root.open-menu == 1 || root.open-menu == 2: Rectangle {
            x: root.menu-x;
            y: root.menu-y;
            width: root.menu-width;
            height: root.menu-height;
            border-radius: 10px;
            background: #1d2737;
            border-width: 1px;
            border-color: #ffffff30;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 5px;
            drop-shadow-color: #00000070;
            TouchArea { } // 菜单留白不触发外部关闭或底层画布。
            VerticalLayout {
                padding: 7px;
                spacing: 0px;
                if root.open-menu == 1: ToolMenuItem { label: "矩形"; icon: @image-url("static/shape-rectangle.svg"); selected: root.shape-tool == 2; clicked => { root.select-shape(2); } }
                if root.open-menu == 1: ToolMenuItem { label: "圆形"; icon: @image-url("static/shape-circle.svg"); selected: root.shape-tool == 14; clicked => { root.select-shape(14); } }
                if root.open-menu == 1: ToolMenuItem { label: "方形"; icon: @image-url("static/shape-square.svg"); selected: root.shape-tool == 13; clicked => { root.select-shape(13); } }
                if root.open-menu == 2: ToolMenuItem { label: "马赛克"; icon: @image-url("static/effects.svg"); selected: root.effect-mode == 0; clicked => { root.select-effect(0); } }
                if root.open-menu == 2: ToolMenuItem { label: "高斯模糊"; icon: @image-url("static/blur.svg"); selected: root.effect-mode == 1; clicked => { root.select-effect(1); } }
            }
        }
    }
}
