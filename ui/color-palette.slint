// 彩虹按钮打开的默认色盘。保留一组高饱和色和灰阶/常用色，选择后立即关闭。
component PaletteDot inherits Rectangle {
    in property <color> swatch;
    in property <color> selected-color;
    callback clicked();
    width: 24px;
    height: 25px;
    border-radius: 7px;
    background: area.has-hover ? #ffffff16 : transparent;
    Rectangle {
        x: 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.swatch;
        border-width: root.swatch == root.selected-color ? 2px : 1px;
        border-color: root.swatch == root.selected-color ? white : #ffffff55;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ColorPalette inherits Rectangle {
    in property <color> selected-color;
    callback color-selected(color);
    width: 278px;
    height: 174px;
    border-radius: 11px;
    border-width: 1px;
    border-color: #ffffff30;
    background: #1d2737;
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 5px;
    drop-shadow-color: #00000070;
    TouchArea { } // 色盘内留白不穿透到关闭浮层或截图画布。

    Text {
        x: 12px;
        y: 8px;
        text: "选择颜色";
        color: #e8effb;
        font-size: 12px;
        font-weight: 600;
    }
    Text {
        x: 180px;
        y: 8px;
        text: "当前";
        color: #8fa1bb;
        font-size: 11px;
    }
    Rectangle {
        x: 218px;
        y: 7px;
        width: 42px;
        height: 20px;
        border-radius: 5px;
        background: root.selected-color;
        border-width: 1px;
        border-color: #ffffff70;
    }

    HorizontalLayout {
        x: 8px;
        y: 36px;
        width: 262px;
        height: 26px;
        spacing: 2px;
        for color in [#ff3b30, #ff9500, #ffcc00, #34c759, #00c7be, #30b0c7, #0a84ff, #5856d6, #af52de, #ff2d55]: PaletteDot {
            swatch: color;
            selected-color: root.selected-color;
            clicked => { root.color-selected(color); }
        }
    }
    HorizontalLayout {
        x: 8px;
        y: 70px;
        width: 262px;
        height: 26px;
        spacing: 2px;
        for color in [#ffffff, #f2f2f7, #d1d1d6, #aeaeb2, #8e8e93, #636366, #48484a, #1c1c1e, #8b5e3c, #64d2ff]: PaletteDot {
            swatch: color;
            selected-color: root.selected-color;
            clicked => { root.color-selected(color); }
        }
    }
    Rectangle { x: 10px; y: 107px; width: 258px; height: 1px; background: #ffffff18; }
    Text {
        x: 12px;
        y: 119px;
        text: "常用颜色";
        color: #8fa1bb;
        font-size: 11px;
    }
    HorizontalLayout {
        x: 76px;
        y: 112px;
        width: 190px;
        height: 34px;
        spacing: 3px;
        for color in [#ff6b6b, #ffd166, #06d6a0, #118ab2, #8338ec, #fb5607]: PaletteDot {
            width: 28px;
            height: 34px;
            swatch: color;
            selected-color: root.selected-color;
            clicked => { root.color-selected(color); }
        }
    }
}
